# Client-side configuration (NEXT_PUBLIC_*).
# These values are inlined into the browser bundle at Next.js build time and
# must be available when building production images (see frontend/Dockerfile).

NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=openlearn
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=openlearn-frontend

# Optional. Leave empty to disable client-side Sentry.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry deployment environment label (Phase 6 Batch 3 / D14).
# Allowed values: development | staging | production.
# Defaults to "development" when unset or invalid.
# Must match the server-side SENTRY_ENVIRONMENT variable in deployment
# so client and server events share the same environment label.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
