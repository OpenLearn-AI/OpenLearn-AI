# =============================================================================
# Staging environment template — mirrors the .env.runtime generated by
# .github/workflows/deploy-staging.yml (GitHub Secrets/Variables -> heredoc).
#
# .env.runtime is REGENERATED on every deploy: durable values must live in
# GitHub Secrets/Variables, never in hand-edited server files.
#
# Interpolation only: docker compose reads this file via
# `--env-file .env.runtime` (infra/deploy.sh) and substitutes ${VAR} in
# docker-compose.staging.yml. Adding a variable here does nothing unless the
# compose file references it.
# =============================================================================

# ── Backend ──
# NOTE: the application builds async SQLAlchemy engines from this URL, so the
# scheme MUST be postgresql+asyncpg:// (a plain postgresql:// URL fails at
# engine creation).
DATABASE_URL=postgresql+asyncpg://openlearn:CHANGE_ME@db:5432/openlearn_staging
ENVIRONMENT=staging

# ── PostgreSQL ──
POSTGRES_USER=openlearn
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=openlearn_staging

# ── Frontend build args (GitHub Variables; used at image build time) ──
NEXT_PUBLIC_API_URL=https://staging-api.openlearn-ai.example.com

# Sentry environment label. NEXT_PUBLIC_SENTRY_ENVIRONMENT is BUILD-TIME:
# passed as a Docker build arg (frontend/Dockerfile) and inlined into the
# client bundle via lib/config.ts. SENTRY_ENVIRONMENT (below, next to the
# DSN) is RUNTIME: read by sentry.server.config.ts from the container
# environment. deploy-staging.yml sources both from the same GitHub
# Variable (NEXT_PUBLIC_SENTRY_ENVIRONMENT, falling back to "staging") so
# client and server events always share one label. Allowed values:
# development | staging | production.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging

# Sentry DSN (public-by-design; safe to expose): the client copy is the
# build-time NEXT_PUBLIC_SENTRY_DSN GitHub Secret → Dockerfile ARG; the
# server copy below is runtime — it feeds the compose ${SENTRY_DSN}
# interpolation in the frontend service. Leave empty to disable Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# ── Sentry source-map upload (BUILD-TIME only; never runtime) ──
# Read by @sentry/nextjs' withSentryConfig during the image build
# (`npm run build` inside frontend/Dockerfile, which mounts them as
# BuildKit secrets — they never enter image layers, the runtime
# environment, or .env.runtime). Sourced in deploy-staging.yml from GitHub
# Secrets. Leave empty to skip the upload; the build still succeeds.
# SENTRY_AUTH_TOKEN: real secret (token with artifact write access to the
# Sentry org). SENTRY_ORG / SENTRY_PROJECT: non-secret Sentry slugs (see
# frontend/next.config.ts). Never put real values in this example file.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME

# ── LiteLLM proxy ──
LITELLM_MASTER_KEY=sk-change-me-in-production
LITELLM_SALT_KEY=change-me-random-salt

# ── Week 7-8 AI runtime (H1) ──
# LITELLM_API_KEY: key the celery_worker uses to authenticate to the gateway.
# Staging has no virtual-key database, so this is currently the same value as
# LITELLM_MASTER_KEY; rotate them together.
LITELLM_API_KEY=sk-change-me-in-production

# GEMINI_API_KEY: one Google AI Studio key serving TWO roles since
# B6-PREP-GEMINI — (1) the celery_worker's direct Gemini OCR
# (GeminiOCRProvider, targeted OCR of low-text PDF pages — the OCR path does
# NOT go through the LiteLLM gateway) and (2) the litellm container's
# reasoning upstream key (infra/litellm-config.yaml resolves
# os.environ/GEMINI_API_KEY for the gemini/gemini-3.6-flash model entry).
GEMINI_API_KEY=

# NOTE: no OpenAI provider key is required — the deployed reasoning path has
# no OpenAI model entry or fallback (see litellm-config.yaml FALLBACK POLICY).

# The Week 7-8 provider selection (AI_REASONING_PROVIDER=litellm,
# AI_EMBEDDING_PROVIDER=bge-m3, AI_VECTOR_DB_PROVIDER=postgres,
# AI_OCR_PROVIDER=gemini, model/dimension/device, LITELLM_API_BASE) is
# hardcoded in docker-compose.staging.yml's celery_worker service — it is not
# interpolated from this file and must be changed there, not here.

# ── Grafana ──
GRAFANA_ADMIN_USER=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── Keycloak admin ──
KEYCLOAK_ADMIN_USER=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ── Keycloak public config (GitHub Variables; frontend build args) ──
NEXT_PUBLIC_KEYCLOAK_URL=https://keycloak-staging.duckdns.org
NEXT_PUBLIC_KEYCLOAK_REALM=openlearn
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=openlearn-frontend

# ── MinIO / S3-compatible object storage ──
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET_NAME=openlearn-materials
S3_REGION_NAME=us-east-1
S3_URL_EXPIRATION_SECONDS=3600
