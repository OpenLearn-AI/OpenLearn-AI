# ── Backend ──
DATABASE_URL=postgresql://openlearn:CHANGE_ME@db:5432/openlearn_staging
ENVIRONMENT=staging

# ── PostgreSQL ──
POSTGRES_USER=openlearn
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=openlearn_staging

# ── Frontend ──
NEXT_PUBLIC_API_URL=https://staging-api.openlearn-ai.example.com
SENTRY_DSN=

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME

# ── LiteLLM Proxy ──
LITELLM_MASTER_KEY=sk-change-me-in-production
LITELLM_SALT_KEY=change-me-random-salt

# ── Grafana ──
GRAFANA_ADMIN_USER=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── Keycloak admin ──
KEYCLOAK_ADMIN_USER=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ── MinIO / S3-compatible object storage ──
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET_NAME=openlearn-materials
S3_REGION_NAME=us-east-1
S3_URL_EXPIRATION_SECONDS=3600
