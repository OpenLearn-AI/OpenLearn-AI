#!/usr/bin/env bash
# =============================================================================
# verify-local-environment.sh
#
# OpenLearn-AI — frontend-redesign — local environment verification.
#
# The local counterpart of the staging verifiers (scripts/b7_staging_verification.sh,
# scripts/b8_staging_verification.sh), following their purpose, structure,
# conventions, and reporting style while targeting ONLY the local development
# environment (infra/docker-compose.dev.yml + host-run API/worker):
#
#   Staging verifiers inspect the deployed staging stack from the inside
#   (docker exec into containers, VPS network). This verifier checks the same
#   categories against the local stack: services and readiness, configuration
#   (non-secret values), backend API health, Celery worker readiness and task
#   discovery, database prerequisites for the ingestion pipeline, storage
#   connectivity through the application's real client code path, and the
#   demo accounts the material journey depends on.
#
# Deliberate differences from the staging verifiers (nothing silent):
#   * NO resource creation and NO cleanup section: the staging verifiers prove
#     the pipeline by creating/deleting user/course/material/S3/task records.
#     Here that capability lives in the separate, opt-in ingestion smoke test
#     (scripts/run-material-smoke-test.sh) — environment health and end-to-end
#     processing are distinct concerns, per the local environment batch.
#   * The staging `worker_py` import-context helper is unnecessary: locally the
#     application code runs from backend/.venv with cwd=backend, so `import app`
#     works directly; probes that import application modules cd to backend/.
#   * Litellm/Loki/Grafana/Alloy/Sentry checks are absent: those services are
#     staging-only infrastructure; the material pipeline does not touch them.
#
# What it checks (each becomes one recorded verdict):
#   0. PREFLIGHT          tools, repo detection, environment files present
#   1. REPOSITORY STATE   branch/HEAD/dirty-tree note (informational)
#   2. SERVICES           db/redis/minio running AND ready; keycloak realm up;
#                         materials bucket present
#   3. CONFIGURATION      non-secret report + credential-consistency checks
#                         (backend/.env S3 creds == .env.local MinIO creds;
#                          REDIS_PASSWORD present; REDIS_URL override state)
#   4. BACKEND API        GET /health (+ optional --start-backend)
#   5. WORKER             broker reachable from the app's own config; worker
#                         process answering `celery inspect ping`;
#                         process_material registered; ingestion_queue consumed
#   6. DB PREREQUISITES   pgvector extension; vector_records + materials
#                         tables; ck_materials_status_supported; alembic
#                         version == repo head (read-only SQL)
#   7. STORAGE CLIENT     head_bucket through the REAL app code path
#                         (backend venv + app.config settings + SigV4 client)
#   8. AI PROVIDERS       configured providers construct cleanly (no calls);
#                         the configured vector-db provider is reported
#   9. DEMO ACCOUNTS      testuser (student) + instructor exist in the realm
#                         (read-only kcadm query)
#   10. VERDICT           mechanical; exit code derived from REQUIRED checks
#
# Verdict semantics (house style, matches the AI Week 7-8 + Batch 0.1
# verifiers): PASS / FAIL / BLOCKED / SKIPPED are distinct. A missing-but-
# startable process (backend, worker) is BLOCKED with the exact start command,
# not FAIL — the environment is not broken, a step was not taken. The exit
# code is derived mechanically from the REQUIRED criteria only.
#
# Exit codes: 0 = every REQUIRED check PASS; 1 = at least one REQUIRED check
# FAIL/BLOCKED; 2 = preflight fatal (missing tools/environment files/repo).
#
# Guarantees (mirror the batch rules and the staging verifiers):
#   * READ-ONLY for the repository: no tracked file is created/modified; the
#     run writes only to the evidence directory (default: OUTSIDE the repo).
#   * NEVER prints secret values: passwords/tokens are reported SET/MISSING;
#     REDIS_URL / DATABASE_URL are printed with credentials masked.
#   * No service is restarted, no data deleted, no config changed, nothing
#     installed. Safe to run repeatedly at any time.
#   * Targets local services only; never falls back to staging; staging is
#     never contacted.
#
# Usage:
#   bash scripts/verify-local-environment.sh
#       --start-backend   if GET /health fails and backend/.venv exists, start
#                         uvicorn (same pattern as the Batch 0.1 verifier),
#                         wait, and re-check; default: BLOCKED + start command
#
# Requirements: Docker + compose v2 (services up), bash, curl, python3.
# Assumes scripts/setup-dev.sh has been run at least once (.env.local,
# backend/.env, backend/.venv exist).
# =============================================================================

set -uo pipefail

# ----------------------------- configuration --------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="${REPO_DIR:-$SCRIPT_DIR/..}"
REPO_DIR="$(cd "${REPO_DIR}" && pwd)"
if [ ! -f "$REPO_DIR/frontend/package.json" ] || [ ! -f "$REPO_DIR/scripts/setup-dev.sh" ]; then
  echo "ERROR: could not locate the OpenLearn-AI repository at $REPO_DIR." >&2
  echo "       Run from the repo, or set REPO_DIR=/path/to/OpenLearn-AI." >&2
  exit 66
fi

API_URL="${API_URL:-http://localhost:8000}"
KC_DISCOVERY="${KC_DISCOVERY:-http://localhost:8080/realms/openlearn/.well-known/openid-configuration}"
DC=(docker compose --env-file "$REPO_DIR/.env.local" -f "$REPO_DIR/infra/docker-compose.dev.yml")

START_BACKEND=0
for arg in "$@"; do
  case "$arg" in
    --start-backend) START_BACKEND=1 ;;
    *) echo "unknown option: $arg" >&2; exit 64 ;;
  esac
done

TS="$(date +%Y%m%d-%H%M%S)"
EVIDENCE_DIR="${EVIDENCE_DIR:-$REPO_DIR/../openlearn-local-env-evidence/run-$TS}"
mkdir -p "$EVIDENCE_DIR"
chmod 700 "$EVIDENCE_DIR"
LOG="$EVIDENCE_DIR/evidence.log"

# ----------------------------- tiny framework -------------------------------
declare -a CHECK_IDS=(); declare -A CHECK_STATE=(); declare -A CHECK_NOTE=()
record() { # record <id> <state> <note...>
  CHECK_IDS+=("$1"); CHECK_STATE["$1"]="$2"; CHECK_NOTE["$1"]="$3"
  printf '  -> %-30s %s\n' "$1" "$2"
}
section() { printf '\n== %s ==\n' "$*"; }
fail_soft() { # fatal preflight failure — cannot continue meaningfully
  printf 'FATAL: %s\n' "$*" >&2
  exit 2
}
# env file reader: prints the first VALUE of NAME in FILE (never secret names'
# values into the log; callers must not echo secrets)
env_var_value() { # <name> <file>
  sed -n "s/^${1}=//p" "$2" | head -1 | tr -d '\r'
}
# mask credentials in a URL before any logging
mask_url() { # <url-with-:user:pass@>
  sed -E 's#://[^@/]*@#://<credentials>@#' <<< "$1"
}

exec > >(tee -a "$LOG") 2>&1
cat <<EOF
==============================================================================
OpenLearn-AI — LOCAL ENVIRONMENT verification run
repo:     $REPO_DIR
branch:   $(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
HEAD:     $(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || echo '?')
api:      $API_URL
evidence: $EVIDENCE_DIR
options:  start-backend=$START_BACKEND
Scope: local environment health/readiness ONLY. No resources are created.
For end-to-end ingestion see scripts/run-material-smoke-test.sh.
==============================================================================
EOF

cleanup() {
  # nothing persistent is created by this verifier; keep the hook for parity
  # with the house style (0.1 verifier deletes its token file here)
  :
}
trap cleanup EXIT

# ----------------------------- 0. preflight ---------------------------------
section "0. Preflight"
MISSING=0
for tool in docker curl python3 git; do
  if ! command -v "$tool" >/dev/null 2>&1; then echo "missing tool: $tool"; MISSING=1; fi
done
[ "$MISSING" = "0" ] || fail_soft "install the missing tools above and re-run"
if ! docker compose version >/dev/null 2>&1; then
  fail_soft "Docker Compose v2 ('docker compose' plugin) is required but not available."
fi
docker info >/dev/null 2>&1 || fail_soft "Docker daemon not reachable — start Docker and re-run."
echo "docker compose plugin + daemon: OK"

[ -f "$REPO_DIR/.env.local" ] || fail_soft ".env.local not found in $REPO_DIR — run: bash scripts/setup-dev.sh"
[ -f "$REPO_DIR/backend/.env" ] || fail_soft "backend/.env not found — run: bash scripts/setup-dev.sh"
[ -f "$REPO_DIR/backend/.env.example" ] || fail_soft "backend/.env.example missing — repository is incomplete"
echo "environment files: .env.local + backend/.env present"

if ! (cd "$REPO_DIR/backend" && [ -x ".venv/bin/python" ] || [ -x ".venv/Scripts/python.exe" ]); then
  fail_soft "backend/.venv missing — run: bash scripts/setup-dev.sh"
fi
echo "backend/.venv present"

START_STATE="$(git -C "$REPO_DIR" status --porcelain)"
if [ -n "$START_STATE" ]; then
  echo "NOTE: working tree is not clean at start (pre-existing changes are preserved, never touched):"
  echo "$START_STATE"
fi

# ----------------------------- 1. repository state --------------------------
section "1. Repository state (informational)"
echo "branch: $(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
echo "HEAD:   $(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || echo '?')"

# ----------------------------- 2. services ----------------------------------
section "2. Local services (docker: db, redis, minio, keycloak)"
PS_OUT="$("${DC[@]}" ps --services --filter status=running 2>/dev/null || true)"
echo "running services: $(echo "$PS_OUT" | tr '\n' ' ')"

for SVC in db redis minio keycloak; do
  if printf '%s\n' "$PS_OUT" | grep -qx "$SVC"; then
    record "services.$SVC.running" "PASS" "compose service running"
  else
    record "services.$SVC.running" "BLOCKED" "not running — start with: docker compose --env-file .env.local -f infra/docker-compose.dev.yml up -d $SVC"
  fi
done

REDIS_PASSWORD_VALUE="$(env_var_value REDIS_PASSWORD "$REPO_DIR/.env.local")"
[ -n "$REDIS_PASSWORD_VALUE" ] || record "config.redis-password" "FAIL" "REDIS_PASSWORD missing/empty in .env.local — run scripts/setup-dev.sh (re-checked in section 3)"

REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
if printf '%s\n' "$PS_OUT" | grep -qx "redis"; then
  if "${DC[@]}" exec -T -e REDISCLI_AUTH="${REDIS_PASSWORD_VALUE}" redis \
      redis-cli --no-auth-warning ping 2>/dev/null | grep -q PONG; then
    record "services.redis.ready" "PASS" "authenticated PING answered (broker accepts commands)"
  else
    record "services.redis.ready" "FAIL" "redis running but PING failed (wrong REDIS_PASSWORD in .env.local? check: docker compose logs redis)"
  fi
fi

MINIO_BUCKET="$(env_var_value S3_BUCKET_NAME "$REPO_DIR/.env.local")"
if printf '%s\n' "$PS_OUT" | grep -qx "minio"; then
  if "${DC[@]}" exec -T minio mc ready local >/dev/null 2>&1; then
    record "services.minio.ready" "PASS" "S3 API answers (mc ready local)"
  else
    record "services.minio.ready" "FAIL" "minio running but S3 API not ready — check: docker compose logs minio"
  fi
  if [ -n "$MINIO_BUCKET" ] && "${DC[@]}" exec -T minio mc stat "local/$MINIO_BUCKET" >/dev/null 2>&1; then
    record "services.minio.bucket" "PASS" "bucket '$MINIO_BUCKET' exists (bucket name is config, not a secret)"
  else
    record "services.minio.bucket" "FAIL" "bucket missing — run the one-shot init: docker compose --env-file .env.local -f infra/docker-compose.dev.yml --profile init up -d minio-init && docker compose --env-file .env.local -f infra/docker-compose.dev.yml --profile init wait minio-init"
  fi
fi

if printf '%s\n' "$PS_OUT" | grep -qx "db"; then
  if "${DC[@]}" exec -T db pg_isready -U openlearn -d openlearn_dev >/dev/null 2>&1; then
    record "services.db.ready" "PASS" "pg_isready ok on the application database openlearn_dev"
  else
    record "services.db.ready" "FAIL" "db running but openlearn_dev not accepting connections — check: docker compose logs db"
  fi
fi

if curl --noproxy '*' -fsS --max-time 5 "$KC_DISCOVERY" >/dev/null 2>&1; then
  record "services.keycloak.realm" "PASS" "OIDC discovery answered for realm 'openlearn'"
else
  record "services.keycloak.realm" "BLOCKED" "discovery not answering on localhost:8080 — start keycloak or re-run setup-dev.sh"
fi

# ----------------------------- 3. configuration ------------------------------
section "3. Configuration report (non-secret values; secrets as SET/MISSING only)"

report_env() { # <name> <file> <required: req|opt> <secret: secret|plain>
  local name="$1" file="$2" req="$3" kind="$4" value
  value="$(env_var_value "$name" "$file")"
  if [ -n "$value" ]; then
    if [ "$kind" = "secret" ]; then
      echo "  $name: SET ($file)"
    else
      echo "  $name: $value ($file)"
    fi
    return 0
  else
    echo "  $name: MISSING ($file)"
    return 1
  fi
}

echo "backend/.env (application settings):"
report_env DATABASE_URL "$REPO_DIR/backend/.env" req secret
report_env S3_ENDPOINT_URL "$REPO_DIR/backend/.env" req plain
report_env S3_BUCKET_NAME "$REPO_DIR/backend/.env" req plain
report_env AI_OCR_PROVIDER "$REPO_DIR/backend/.env" opt plain || true
report_env AI_EMBEDDING_PROVIDER "$REPO_DIR/backend/.env" opt plain || true
report_env AI_VECTOR_DB_PROVIDER "$REPO_DIR/backend/.env" opt plain || true

echo ".env.local (compose + worker credentials):"
report_env REDIS_PASSWORD "$REPO_DIR/.env.local" req secret || true
report_env MINIO_ROOT_USER "$REPO_DIR/.env.local" req secret || true
report_env MINIO_ROOT_PASSWORD "$REPO_DIR/.env.local" req secret || true
report_env S3_BUCKET_NAME "$REPO_DIR/.env.local" req plain || true
report_env OPENLEARN_TEST_USER_PASSWORD "$REPO_DIR/.env.local" req secret || true
report_env OPENLEARN_INSTRUCTOR_USER_PASSWORD "$REPO_DIR/.env.local" req secret || true
REDIS_URL_FILE_VALUE="$(env_var_value REDIS_URL "$REPO_DIR/.env.local")"
if [ -n "$REDIS_URL_FILE_VALUE" ]; then
  echo "  REDIS_URL: SET in .env.local — $(mask_url "$REDIS_URL_FILE_VALUE") (explicit override honored)"
else
  echo "  REDIS_URL: not set in .env.local (run-worker-dev.sh defaults to redis://<credentials>@127.0.0.1:6379)"
fi

# credential consistency: the backend must authenticate to MinIO as the SAME
# user the MinIO service was started with. Compare without printing values.
BACKEND_S3_USER="$(env_var_value S3_ACCESS_KEY_ID "$REPO_DIR/backend/.env")"
BACKEND_S3_PASS="$(env_var_value S3_SECRET_ACCESS_KEY "$REPO_DIR/backend/.env")"
LOCAL_MINIO_USER="$(env_var_value MINIO_ROOT_USER "$REPO_DIR/.env.local")"
LOCAL_MINIO_PASS="$(env_var_value MINIO_ROOT_PASSWORD "$REPO_DIR/.env.local")"
if [ -n "$BACKEND_S3_USER" ] && [ -n "$BACKEND_S3_PASS" ] \
   && [ -n "$LOCAL_MINIO_USER" ] && [ -n "$LOCAL_MINIO_PASS" ] \
   && [ "$BACKEND_S3_USER" = "$LOCAL_MINIO_USER" ] && [ "$BACKEND_S3_PASS" = "$LOCAL_MINIO_PASS" ]; then
  record "config.s3-credentials" "PASS" "backend/.env S3 credentials match the .env.local MinIO credentials (values not printed)"
else
  record "config.s3-credentials" "FAIL" "S3 credentials missing or backend/.env does NOT match .env.local MinIO credentials — presigned uploads and worker fetches will fail; re-run scripts/setup-dev.sh (it appends only) or fix manually"
fi

if [ -n "$MINIO_BUCKET" ] && [ "$MINIO_BUCKET" = "$(env_var_value S3_BUCKET_NAME "$REPO_DIR/backend/.env")" ]; then
  record "config.s3-bucket" "PASS" "S3_BUCKET_NAME consistent across .env.local and backend/.env ($MINIO_BUCKET)"
else
  record "config.s3-bucket" "FAIL" "S3_BUCKET_NAME missing or inconsistent between .env.local and backend/.env"
fi

if [ -n "$REDIS_PASSWORD_VALUE" ]; then
  record "config.redis-password" "PASS" "REDIS_PASSWORD present in .env.local (required by app/workers/celery_app.py)"
else
  record "config.redis-password" "FAIL" "REDIS_PASSWORD missing in .env.local — the Celery app refuses to import without it"
fi

# ----------------------------- 4. backend API -------------------------------
section "4. Backend API (host uvicorn)"
BE_STARTED_BY_VERIFIER=0
BE_OK=0
for i in 1 2 3 4; do
  if curl -sf --max-time 5 "$API_URL/health" >/dev/null 2>&1; then BE_OK=1; break; fi
  sleep 2
done
if [ "$BE_OK" != "1" ] && [ "$START_BACKEND" = "1" ]; then
  echo "backend not answering; --start-backend given — starting uvicorn from backend/.venv ..."
  ( cd "$REPO_DIR/backend" && nohup .venv/bin/uvicorn app.main:app --port 8000 \
      > "$EVIDENCE_DIR/backend.log" 2>&1 & echo $! > "$EVIDENCE_DIR/backend.pid" )
  BE_STARTED_BY_VERIFIER=1
  for i in $(seq 1 24); do curl -sf --max-time 5 "$API_URL/health" >/dev/null 2>&1 && BE_OK=1 && break; sleep 5; done
fi
if [ "$BE_OK" = "1" ]; then
  record "api.health" "PASS" "GET $API_URL/health OK"
else
  record "api.health" "BLOCKED" "backend not answering on $API_URL — start it: cd backend && source .venv/bin/activate && uvicorn app.main:app --reload --port 8000 (or re-run with --start-backend)"
fi

# ----------------------------- 5. worker ------------------------------------
section "5. Celery worker (broker + task discovery + queues)"
# Export the SAME environment scripts/run-worker-dev.sh exports, then probe
# with the application's own Celery app — no reimplementation of its config.
VENV_BIN="$REPO_DIR/backend/.venv/bin"
[ -x "$VENV_BIN/celery" ] || VENV_BIN="$REPO_DIR/backend/.venv/Scripts"
WORKER_ENV=(env REDIS_PASSWORD="$REDIS_PASSWORD_VALUE")
if [ -n "$REDIS_URL_FILE_VALUE" ]; then
  WORKER_ENV+=(REDIS_URL="$REDIS_URL_FILE_VALUE")
else
  WORKER_ENV+=(REDIS_URL="redis://:${REDIS_PASSWORD_VALUE}@127.0.0.1:6379")
fi
echo "probe REDIS_URL: $(mask_url "${WORKER_ENV[${#WORKER_ENV[@]}-1]}")"

BROKER_OUT="$( cd "$REPO_DIR/backend" && "${WORKER_ENV[@]}" "$VENV_BIN/python" - <<'PYEOF' 2>&1
from kombu import Connection
from app.workers.celery_app import CELERY_BROKER_URL
try:
    with Connection(CELERY_BROKER_URL) as conn:
        conn.ensure_connection(max_retries=2, timeout=5)
    print("BROKER_REACHABLE")
except Exception as e:
    print(f"BROKER_UNREACHABLE: {type(e).__name__}")
PYEOF
)" 2>&1
echo "$BROKER_OUT" | tail -2 | tee "$EVIDENCE_DIR/broker-probe.txt" >/dev/null
if printf '%s' "$BROKER_OUT" | grep -q "BROKER_REACHABLE"; then
  record "worker.broker" "PASS" "broker reachable through the app's own CELERY_BROKER_URL (kombu ensure_connection)"
else
  record "worker.broker" "FAIL" "broker NOT reachable from the app config — is the redis service up and REDIS_PASSWORD correct?"
fi

PING_OUT="$( cd "$REPO_DIR/backend" && "${WORKER_ENV[@]}" "$VENV_BIN/celery" \
    -A app.workers.celery_app inspect ping --timeout 5 2>&1 )"
echo "$PING_OUT" > "$EVIDENCE_DIR/celery-inspect-ping.txt"
if printf '%s' "$PING_OUT" | grep -q "OK"; then
  NODES="$(printf '%s' "$PING_OUT" | grep -c '^->' || true)"
  record "worker.ping" "PASS" "worker answered inspect ping ($NODES node(s)) — see evidence/celery-inspect-ping.txt"
else
  record "worker.ping" "BLOCKED" "no worker process answered — start it: bash scripts/run-worker-dev.sh"
fi

REG_OUT="$( cd "$REPO_DIR/backend" && "${WORKER_ENV[@]}" "$VENV_BIN/celery" \
    -A app.workers.celery_app inspect registered --timeout 5 2>&1 )"
echo "$REG_OUT" > "$EVIDENCE_DIR/celery-inspect-registered.txt"
if printf '%s' "$REG_OUT" | grep -q "app.workers.tasks.material_tasks.process_material"; then
  record "worker.registered-tasks" "PASS" "process_material registered on the running worker"
else
  if printf '%s' "$PING_OUT" | grep -q "OK"; then
    record "worker.registered-tasks" "FAIL" "worker is up but process_material is NOT registered — task discovery broken (include list / import error; see worker logs)"
  else
    record "worker.registered-tasks" "SKIPPED" "worker not running — registered-task discovery requires it"
  fi
fi

Q_OUT="$( cd "$REPO_DIR/backend" && "${WORKER_ENV[@]}" "$VENV_BIN/celery" \
    -A app.workers.celery_app inspect active_queues --timeout 5 2>&1 )"
echo "$Q_OUT" > "$EVIDENCE_DIR/celery-inspect-queues.txt"
if printf '%s' "$Q_OUT" | grep -q "ingestion_queue"; then
  record "worker.queues" "PASS" "worker consumes ingestion_queue (where material tasks are routed) + default queue"
else
  if printf '%s' "$PING_OUT" | grep -q "OK"; then
    record "worker.queues" "FAIL" "worker up but does NOT consume ingestion_queue — material tasks would be silently lost (must run with -Q celery,ingestion_queue)"
  else
    record "worker.queues" "SKIPPED" "worker not running — queue discovery requires it"
  fi
fi

# ----------------------------- 6. db prerequisites --------------------------
section "6. Database prerequisites (read-only SQL via compose psql)"
psql_q() { "${DC[@]}" exec -T db psql -U openlearn -d openlearn_dev -tAc "$1" 2>/dev/null; }

EXT_OK="$(psql_q "SELECT extname FROM pg_extension WHERE extname='vector';")"
if [ "$EXT_OK" = "vector" ]; then
  record "db.pgvector-extension" "PASS" "CREATE EXTENSION vector present (migration f3a1b7c9d4e2)"
else
  record "db.pgvector-extension" "FAIL" "vector extension missing in openlearn_dev — run: cd backend && .venv/bin/python -m alembic upgrade head"
fi

VT_OK="$(psql_q "SELECT to_regclass('public.vector_records') IS NOT NULL;")"
MT_OK="$(psql_q "SELECT to_regclass('public.materials') IS NOT NULL;")"
if [ "$VT_OK" = "t" ] && [ "$MT_OK" = "t" ]; then
  record "db.tables" "PASS" "materials + vector_records tables exist"
else
  record "db.tables" "FAIL" "materials($MT_OK) / vector_records($VT_OK) missing — migrations not at head"
fi

CK_OK="$(psql_q "SELECT conname FROM pg_constraint WHERE conname='ck_materials_status_supported';")"
if [ "$CK_OK" = "ck_materials_status_supported" ]; then
  record "db.status-constraint" "PASS" "ck_materials_status_supported enforces pending|processing|ready|failed"
else
  record "db.status-constraint" "FAIL" "materials status CHECK constraint missing — schema drift"
fi

ALEMBIC_DB="$(psql_q "SELECT version_num FROM alembic_version;" | tail -1 | tr -d '[:space:]')"
ALEMBIC_REPO="$( cd "$REPO_DIR/backend" && .venv/bin/python -m alembic heads 2>/dev/null | awk '{print $1}' | head -1 | tr -d '[:space:]' )"
echo "alembic: db=${ALEMBIC_DB:-<none>} repo-head=${ALEMBIC_REPO:-<none>}"
if [ -n "$ALEMBIC_DB" ] && [ "$ALEMBIC_DB" = "$ALEMBIC_REPO" ]; then
  record "db.alembic-head" "PASS" "database schema at repository migration head ($ALEMBIC_DB)"
else
  record "db.alembic-head" "FAIL" "alembic_version in db (${ALEMBIC_DB:-none}) != repository head (${ALEMBIC_REPO:-none}) — run: cd backend && .venv/bin/python -m alembic upgrade head"
fi

# ----------------------------- 7. storage client -----------------------------
section "7. Storage connectivity through the application's real client path"
STOR_OUT="$( cd "$REPO_DIR/backend" && "$VENV_BIN/python" - <<'PYEOF' 2>&1
from app.config import settings
import boto3
from botocore.config import Config
from botocore.exceptions import ClientError, EndpointConnectionError
client = boto3.client(
    "s3",
    endpoint_url=settings.s3_endpoint_url,
    aws_access_key_id=settings.s3_access_key_id,
    aws_secret_access_key=settings.s3_secret_access_key,
    region_name=settings.s3_region_name,
    config=Config(signature_version="s3v4"),
)
try:
    client.head_bucket(Bucket=settings.s3_bucket_name)
    print(f"STORAGE_OK endpoint={settings.s3_endpoint_url} bucket={settings.s3_bucket_name}")
except EndpointConnectionError:
    print(f"STORAGE_UNREACHABLE endpoint={settings.s3_endpoint_url} (is the minio service up?)")
except ClientError as e:
    code = e.response.get("Error", {}).get("Code", "?")
    print(f"STORAGE_AUTH_OR_BUCKET_ERROR code={code} endpoint={settings.s3_endpoint_url} bucket={settings.s3_bucket_name}")
PYEOF
)" 2>&1
echo "$STOR_OUT" | tail -1 | tee "$EVIDENCE_DIR/storage-probe.txt" >/dev/null
if printf '%s' "$STOR_OUT" | grep -q "STORAGE_OK"; then
  record "storage.head-bucket" "PASS" "head_bucket OK with the app's real SigV4 client + configured credentials (same code path as generate_upload_url)"
elif printf '%s' "$STOR_OUT" | grep -q "STORAGE_UNREACHABLE"; then
  record "storage.head-bucket" "FAIL" "S3 endpoint unreachable — is the minio service up and S3_ENDPOINT_URL correct?"
else
  record "storage.head-bucket" "FAIL" "head_bucket failed (credentials mismatch or bucket missing) — see evidence/storage-probe.txt"
fi

# ----------------------------- 8. ai providers -------------------------------
section "8. AI provider configuration (construction only — no provider calls)"
AI_OUT="$( cd "$REPO_DIR/backend" && "$VENV_BIN/python" - <<'PYEOF' 2>&1
from app.config import settings
from app.pal.exceptions import ConfigurationError
from app.pal.factory import get_ocr_provider, get_embedding_provider

ocr_name = "?"
try:
    ocr_name = get_ocr_provider().provider_name
    ocr_state = "constructs"
except ConfigurationError as e:
    ocr_state = f"CONSTRUCTION_ERROR: {e}"

emb_name = "?"
try:
    emb_name = get_embedding_provider().provider_name
    emb_state = "constructs (model loads lazily on first use)"
except ConfigurationError as e:
    emb_state = f"CONSTRUCTION_ERROR: {e}"

print(f"AI_RESULT ocr={ocr_name}({ocr_state}) embedding={emb_name}({emb_state}) vector_db={settings.ai_vector_db_provider}(session-backed; constructed at task time)")
PYEOF
)" 2>&1
echo "$AI_OUT" | tail -1 | tee "$EVIDENCE_DIR/ai-providers.txt" >/dev/null
if printf '%s' "$AI_OUT" | grep -q "CONSTRUCTION_ERROR"; then
  record "ai.providers" "FAIL" "a configured provider failed to construct (typical: AI_OCR_PROVIDER=gemini without GEMINI_API_KEY) — see evidence/ai-providers.txt"
else
  record "ai.providers" "PASS" "configured providers construct cleanly (no external calls made; names in evidence/ai-providers.txt)"
fi

# ----------------------------- 9. demo accounts ------------------------------
section "9. Demo accounts in realm 'openlearn' (read-only kcadm query)"
KCADM_OK=1
"${DC[@]}" exec -T keycloak /opt/keycloak/bin/kcadm.sh config credentials \
  --server http://localhost:8080 --realm master \
  --user admin --password admin >/dev/null 2>&1 || KCADM_OK=0
if [ "$KCADM_OK" != "1" ]; then
  record "keycloak.demo-accounts" "BLOCKED" "could not authenticate kcadm as the local bootstrap admin (admin/admin) — verify the keycloak container is the dev image from infra/docker-compose.dev.yml"
else
  ACCT_MISSING=""
  for U in testuser instructor; do
    ROW="$("${DC[@]}" exec -T keycloak /opt/keycloak/bin/kcadm.sh get users -r openlearn \
        -q "username=$U" --fields username --format csv --noquotes 2>/dev/null | tail -n +2 | tr -d '\r')"
    if [ "$ROW" = "$U" ]; then
      echo "  account present: $U"
    else
      ACCT_MISSING="$ACCT_MISSING $U"
    fi
  done
  if [ -z "$ACCT_MISSING" ]; then
    record "keycloak.demo-accounts" "PASS" "testuser (student) and instructor (instructor) exist — material-journey actors ready"
  else
    record "keycloak.demo-accounts" "FAIL" "missing:$ACCT_MISSING — re-run scripts/setup-dev.sh (bootstrap is idempotent)"
  fi
fi

# ----------------------------- 10. verdict -----------------------------------
section "10. Verdict"
echo "Check results:"
FAILED=0
for id in "${CHECK_IDS[@]}"; do
  st="${CHECK_STATE[$id]}"
  printf '  %-30s %-12s %s\n' "$id" "$st" "${CHECK_NOTE[$id]}"
  case "$st" in FAIL|BLOCKED) FAILED=1 ;; esac
done
echo
echo "Repository state after run (must show no tracked changes):"
git -C "$REPO_DIR" status --porcelain || true
echo
if [ "$BE_STARTED_BY_VERIFIER" = "1" ]; then
  echo "NOTE: the verifier started the backend (pid $(cat "$EVIDENCE_DIR/backend.pid" 2>/dev/null || echo '?'); log: $EVIDENCE_DIR/backend.log)."
  echo "      It keeps running after this script exits — stop it with: kill \$(cat $EVIDENCE_DIR/backend.pid)"
  echo
fi
if [ "$FAILED" = "0" ]; then
  echo "VERDICT: LOCAL ENVIRONMENT VERIFICATION PASSED (exit 0)"
  echo "The local environment is ready for the material-ingestion workflow:"
  echo "  bash scripts/run-material-smoke-test.sh"
  exit 0
else
  echo "VERDICT: LOCAL ENVIRONMENT VERIFICATION HAS FAILURES/BLOCKS (exit 1)"
  echo "Do NOT tune config to force a pass — fix the failed checks (actionable hints above) and re-run."
  exit 1
fi
