APP_NAME=OpenLearn AI
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://openlearn:devpassword@localhost:5432/openlearn_dev

# Keycloak / OIDC
KEYCLOAK_ISSUER=http://localhost:8080/realms/openlearn
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/openlearn/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=openlearn-api
KEYCLOAK_CLIENT_ID=openlearn-frontend

# S3-compatible object storage (MinIO) for course materials
# A local MinIO instance (infra/docker-compose.dev.yml): S3 API on port 9000,
# console on port 9001. The credentials below are written by scripts/setup-dev.sh
# from the values it generates into the root .env.local (MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD) — they must match the MinIO service's credentials.
# On an existing setup the script only appends missing variables; it never
# overwrites values you have set yourself.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=openlearn-materials
S3_REGION_NAME=us-east-1
S3_URL_EXPIRATION_SECONDS=900

# ── Redis / Celery broker (material-processing path) ────────────────────────
# Redis connection settings are resolved by app/config.py (pydantic settings)
# and shared by the API process and the Celery worker. They are INTENTIONALLY
# not declared in this example file:
#   * the generated credentials live ONLY in the repository-root .env.local
#     (REDIS_PASSWORD, plus REDIS_URL pointing at the loopback-published dev
#     Redis) — written by scripts/setup-dev.sh and git-ignored;
#   * app/config.py reads .env.local FIRST and this file SECOND, so any Redis
#     key added here would shadow the generated value (the later file wins).
# Precedence: process environment > backend/.env > .env.local > defaults.
# The knobs are REDIS_URL (optional full-URL override, wins outright) and
# REDIS_PASSWORD (required unless REDIS_URL is set); the default host is the
# container-network name "redis" (staging topology). Both the documented API
# start command and scripts/run-worker-dev.sh work without exporting anything
# on a setup-dev.sh-configured machine. app/workers/celery_app.py fails fast
# with an actionable message when neither variable can be resolved.

# ── AI providers (material-processing pipeline; PAL factory app/pal/factory.py) ──
# These settings affect the Celery worker only (no API endpoint calls a provider).
# The honest local defaults below exercise the REAL processing path for the
# approved born-digital demo dataset; each deviation from staging is stated.

# OCR: "mock" is the safe local default. Born-digital PDFs (the locked demo
# dataset) NEVER invoke OCR — the targeted-OCR gate (settings.ocr_min_text_chars,
# default 50) skips any PDF whose Docling-extracted text is >= 50 chars, so
# mock vs gemini is immaterial for that path. Scanned-PDF OCR locally requires
# AI_OCR_PROVIDER=gemini AND GEMINI_API_KEY (the provider raises at
# construction without a key; the Gemini API is a metered external service).
AI_OCR_PROVIDER=mock

# Embeddings: "bge-m3" is the real staging provider and the honest local
# default. The SentenceTransformer model (BAAI/bge-m3, ~2 GB) downloads from
# HuggingFace on the FIRST embedding call only, then lives in the local
# HuggingFace cache; inference runs on CPU. Set "mock" to skip the download —
# that substitutes deterministic placeholder vectors and must be labeled as a
# mocked stage, not a real pipeline pass.
AI_EMBEDDING_PROVIDER=bge-m3
AI_EMBEDDING_MODEL=BAAI/bge-m3
AI_EMBEDDING_DIMENSION=1024
AI_EMBEDDING_DEVICE=cpu

# Vector persistence: "postgres" is the real path — chunk vectors are upserted
# into the pgvector `vector_records` table, committed atomically with the
# material's `ready` transition. "mock" keeps records in an in-memory dict and
# persists NOTHING; it cannot demonstrate a real pipeline pass.
AI_VECTOR_DB_PROVIDER=postgres

# Reasoning (LiteLLM gateway) is not part of the material-processing path;
# the local worker never calls it. Leave unset (defaults to mock).
