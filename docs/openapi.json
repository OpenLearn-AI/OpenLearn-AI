{
  "components": {
    "schemas": {
      "CourseCreate": {
        "additionalProperties": false,
        "description": "Payload for POST /v1/courses.\n\nIdentity is never accepted from the client: ``owner_id`` is derived from\nthe authenticated token, so unexpected fields are rejected (422).\nTitle bounds mirror the ``courses.title`` varchar(255) column.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "title": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "CourseCreate",
        "type": "object"
      },
      "CourseResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner_id",
          "title",
          "description",
          "created_at"
        ],
        "title": "CourseResponse",
        "type": "object"
      },
      "CurrentUserResponse": {
        "description": "Body of GET /auth/me: the local user plus its realm roles.\n\nField types mirror what the endpoint has always returned: ``id`` is the\nstringified UUID and ``settings`` is the free-form JSONB blob, so\ndeclaring this model changes nothing about the response.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "keycloak": {
            "$ref": "#/components/schemas/KeycloakIdentity"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "settings": {
            "additionalProperties": true,
            "title": "Settings",
            "type": "object"
          }
        },
        "required": [
          "id",
          "email",
          "settings",
          "roles",
          "keycloak"
        ],
        "title": "CurrentUserResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "KeycloakIdentity": {
        "description": "The Keycloak identity pair that owns the local user row (ADR-0006).",
        "properties": {
          "issuer": {
            "title": "Issuer",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "issuer",
          "subject"
        ],
        "title": "KeycloakIdentity",
        "type": "object"
      },
      "MaterialAcceptedResponse": {
        "properties": {
          "job_id": {
            "description": "Celery task id. Intended for log correlation only in W7; it is not queryable through the API.",
            "title": "Job Id",
            "type": "string"
          },
          "material_id": {
            "format": "uuid",
            "title": "Material Id",
            "type": "string"
          }
        },
        "required": [
          "material_id",
          "job_id"
        ],
        "title": "MaterialAcceptedResponse",
        "type": "object"
      },
      "MaterialCreate": {
        "additionalProperties": false,
        "description": "Payload for registering a material after the direct upload completes.\n\n``s3_key`` must be the one returned by the upload-url flow for this course;\nthe endpoint validates it stays inside the course's material namespace.",
        "properties": {
          "s3_key": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "S3 Key",
            "type": "string"
          },
          "title": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "s3_key"
        ],
        "title": "MaterialCreate",
        "type": "object"
      },
      "MaterialResponse": {
        "properties": {
          "course_id": {
            "format": "uuid",
            "title": "Course Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "s3_key": {
            "title": "S3 Key",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "processing",
              "ready",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "uploaded_by": {
            "format": "uuid",
            "title": "Uploaded By",
            "type": "string"
          }
        },
        "required": [
          "id",
          "course_id",
          "title",
          "s3_key",
          "status",
          "uploaded_by",
          "created_at"
        ],
        "title": "MaterialResponse",
        "type": "object"
      },
      "MaterialStatusResponse": {
        "properties": {
          "material_id": {
            "format": "uuid",
            "title": "Material Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "processing",
              "ready",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "material_id",
          "status"
        ],
        "title": "MaterialStatusResponse",
        "type": "object"
      },
      "ProfileResponse": {
        "properties": {
          "daily_available_minutes": {
            "title": "Daily Available Minutes",
            "type": "integer"
          },
          "education_level": {
            "title": "Education Level",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "learning_style_vark": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Learning Style Vark"
          },
          "major": {
            "title": "Major",
            "type": "string"
          },
          "preferred_language": {
            "title": "Preferred Language",
            "type": "string"
          },
          "university": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "University"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "education_level",
          "major",
          "preferred_language",
          "university",
          "learning_style_vark",
          "daily_available_minutes"
        ],
        "title": "ProfileResponse",
        "type": "object"
      },
      "ProfileUpdate": {
        "additionalProperties": false,
        "description": "Full-replacement profile payload for PUT /v1/users/me.\n\nUnexpected fields are rejected (422): identity comes exclusively from the\nauthenticated token, so a client-supplied user_id must never be accepted.\n\neducation_level and learning_style_vark are free-form strings: the spec\ntypes them as enums but defines no members yet. String bounds mirror the\ndatabase column sizes so invalid payloads are rejected with 422 instead of\nsurfacing as database errors.",
        "properties": {
          "daily_available_minutes": {
            "exclusiveMinimum": 0.0,
            "maximum": 1440.0,
            "title": "Daily Available Minutes",
            "type": "integer"
          },
          "education_level": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Education Level",
            "type": "string"
          },
          "learning_style_vark": {
            "anyOf": [
              {
                "maxLength": 20,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Learning Style Vark"
          },
          "major": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Major",
            "type": "string"
          },
          "preferred_language": {
            "enum": [
              "en",
              "ar"
            ],
            "title": "Preferred Language",
            "type": "string"
          },
          "university": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "University"
          }
        },
        "required": [
          "education_level",
          "major",
          "preferred_language",
          "daily_available_minutes"
        ],
        "title": "ProfileUpdate",
        "type": "object"
      },
      "UploadUrlCreate": {
        "additionalProperties": false,
        "description": "Payload for the presigned-URL endpoint.\n\nOnly the minimum metadata required to build a server-side key and carry\nthe material title is accepted; identity and the object key are never\nclient-controlled.",
        "properties": {
          "filename": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "title": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "filename"
        ],
        "title": "UploadUrlCreate",
        "type": "object"
      },
      "UploadUrlResponse": {
        "properties": {
          "course_id": {
            "format": "uuid",
            "title": "Course Id",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "s3_key": {
            "title": "S3 Key",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "upload_url": {
            "title": "Upload Url",
            "type": "string"
          }
        },
        "required": [
          "course_id",
          "title",
          "s3_key",
          "upload_url",
          "expires_in"
        ],
        "title": "UploadUrlResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
